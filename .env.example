# Copiá este archivo a .env y completá los valores.
# cp .env.example .env

# Puerto donde escucha el server (opcional, default 3000)
PORT=3000

# "production" en el servidor real (activa cookies de sesión secure)
NODE_ENV=development

# Generar con: openssl rand -hex 32
SESSION_SECRET=

# Google Cloud Console → Credentials → OAuth client ID (tipo Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe coincidir exactamente con una de las "Authorized redirect URIs" del client OAuth
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# console.anthropic.com/settings/keys — necesaria para la moderación de mensajes
ANTHROPIC_API_KEY=

# Solo hace falta si tu API key quedó "vinculada a tu identidad" en vez de
# a un workspace fijo (Anthropic tira error 400 pidiéndolo en ese caso).
# Lo encontrás en console.anthropic.com/settings/workspaces
ANTHROPIC_WORKSPACE_ID=

# URL pública del frontend, para CORS y redirect post-login (opcional en local)
FRONTEND_URL=

# Ruta del archivo SQLite de almacenamiento (opcional, default ./data.sqlite)
SQLITE_PATH=

# Solo se usa una vez, si existe, para migrar automáticamente un data.json
# de una instalación anterior a este SQLite (opcional, default ./data.json)
DB_PATH=

# Emails de Google (separados por coma) con acceso al panel de administración
# en /admin.html — ej: vos@gmail.com,otro-admin@gmail.com
ADMIN_EMAILS=

# WhatsApp Cloud API (Meta) — developers.facebook.com/apps → tu app → WhatsApp
# Token permanente (system user) con permiso whatsapp_business_messaging
WHATSAPP_TOKEN=
# ID del número de teléfono (no el número en sí) en el panel de WhatsApp de tu app
WHATSAPP_PHONE_NUMBER_ID=
# String propio que vos definís al configurar el webhook en Meta (cualquier valor secreto)
WHATSAPP_VERIFY_TOKEN=
# "App secret" de tu app de Meta — para verificar la firma de cada webhook entrante
WHATSAPP_APP_SECRET=
# Ventana de agrupamiento de notificaciones en ms (opcional, default 120000 = 2min)
WHATSAPP_NOTIFY_DEBOUNCE_MS=

# Notificaciones push del navegador (Web Push / VAPID) — canal alternativo a
# WhatsApp para quien no vinculó teléfono. Generar UNA sola vez con:
#   node scripts/generate-vapid-keys.js
# y pegar acá lo que imprime. Son del proyecto, no de un usuario.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@caosmatik.com.ar

# Firma electrónica (Ley 25.506 Art. 5, NO "firma digital") de los informes
# certificados en PDF — ver signing.js. Generar UNA sola vez con:
#   node scripts/generate-signing-keys.js
# y pegar acá lo que imprime. Son del proyecto, no de un usuario. Si faltan,
# los PDFs certificados se siguen generando igual, solo sin firma.
SIGNING_PRIVATE_KEY=
SIGNING_PUBLIC_KEY=
